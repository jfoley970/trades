# Copy to .env (never commit .env). Encrypt real values with SOPS + age.
DOMAIN=advancedsettings.cloud          # api./admin./rtc./turn. subdomains; wildcard cert *.advancedsettings.cloud
ACME_EMAIL=jimmy@advancedsettings.net
NODE_ENV=production

# Linode DNS API token for Caddy DNS-01 (wildcard cert).
# Scope: Domains = Read/Write ONLY (everything else: No Access). Ideally create it under a restricted
# Linode user that only has a grant on the advancedsettings.cloud domain. Set an expiry and rotate.
LINODE_DNS_API_TOKEN=replace-with-linode-pat

# Static public IP block (placeholders: replace with real addresses)
APP_PUBLIC_IP=203.0.113.10             # 1:1 NAT (or routed) to the app VM; api/admin/rtc A records
APP_LAN_IP=10.225.30.50                # app VM's private IP (TBD)
TURN_PUBLIC_IP=203.0.113.10            # same as APP_PUBLIC_IP, or a 2nd IP from the block for coturn-on-443
TURN_LAN_IP=10.225.30.50               # same as APP_LAN_IP, or the VM's secondary private IP for the 2nd public IP

POSTGRES_USER=trades
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trades

S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-long
S3_BUCKET=trades-dispatch

LIVEKIT_API_KEY=APIchangeme
LIVEKIT_API_SECRET=change-me-at-least-32-chars-long-secret

# Shared TURN REST secret (coturn use-auth-secret). Also write it to ./secrets/turn_secret for LiveKit:
#   printf %s "$TURN_SECRET" > secrets/turn_secret && chmod 600 secrets/turn_secret
TURN_SECRET=change-me-long-random

JWT_SECRET=change-me-long-random
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
EXPO_ACCESS_TOKEN=                     # or FCM service account + APNs key paths
SMS_PROVIDER_API_KEY=
